{
  "name": "bluebolt-ui",
  "version": "0.4.0",
  "description": "Skinnable game-HUD UI kit for Svelte 5: semantic design tokens with two skins (bluebolt blue/white/yellow/black, azure electric-blue glass), motion actions, components and an optional WebGL2 background.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "author": "Yuuta Tsubasa",
  "repository": "github:YuutaTsubasa/bluebolt-ui",
  "files": [
    "src/lib"
  ],
  "svelte": "./src/lib/index.js",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./tokens.css": "./src/lib/styles/tokens.css",
    "./base.css": "./src/lib/styles/base.css",
    "./fonts.css": "./src/lib/styles/fonts.css",
    "./fonts-azure.css": "./src/lib/styles/fonts-azure.css",
    "./skins/bluebolt.css": "./src/lib/styles/skins/bluebolt.css",
    "./skins/azure.css": "./src/lib/styles/skins/azure.css",
    "./styles.css": "./src/lib/styles/index.css",
    "./motion": "./src/lib/motion/index.js",
    "./fx": {
      "svelte": "./src/lib/fx/index.js",
      "default": "./src/lib/fx/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.5"
  }
}
